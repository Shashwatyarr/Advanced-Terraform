# Local .terraform directories and files
**/.terraform/*
.terraform*

# .tfstate files (CRITICAL: Never commit state files to Git)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# passwords, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
# Note: For this academic project we generated dev/test/prod.tfvars without secrets,
# but in a real enterprise repo, these would be ignored or stored encrypted (e.g., SOPS).
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore OS generated files
.DS_Store
Thumbs.db
